# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=waflare-verify-token

# Twilio WhatsApp Voice & Messaging (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ElevenLabs Voice Synthesis (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Multi-LLM Providers (auto-failover order; falls back locally if empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Security, Vault & MCP
VAULT_PASSPHRASE=change-this-32-char-vault-secret
MCP_AUTH_TOKEN=
MCP_READ_ONLY=false

# Cloudflare ChatOps & Alerts
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
OWNER_ALERT_CHANNEL=whatsapp
OWNER_ALERT_TARGET=
ALERT_ON=referrals

# Sently Omnichannel Optional Dispatchers
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
NTFY_TOPIC_URL=
RESEND_API_KEY=
